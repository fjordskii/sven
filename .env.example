# Neon Postgres (set by the Vercel Neon integration)
DATABASE_URL=

# Single-owner login. Long random password; stored as a Vercel sensitive env var.
OWNER_PASSWORD=
# HMAC key for the session cookie. `openssl rand -base64 48`
SESSION_SECRET=

# Bearer token for the agent JSON API (/api/items).
AGENT_API_TOKEN=
