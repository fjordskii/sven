# Auth.js (NextAuth v5). Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional. Auth.js infers this on Vercel from the request host.
# Set it locally if callbacks go to the wrong origin.
# AUTH_URL=http://localhost:3000

# Optional. Case-insensitive. Defaults to fordheacock@gmail.com
# AUTH_ALLOWED_EMAIL=fordheacock@gmail.com

# Optional. HMAC pepper for agent tokens. Falls back to AUTH_SECRET.
# JOURNAL_TOKEN_PEPPER=

# Optional. Timezone for today / coming-days. Defaults to America/New_York.
# JOURNAL_TZ=America/New_York

# Optional. Local JSON directory when Vercel Blob is not configured.
# JOURNAL_DATA_DIR=.data

# Set automatically when you create a private Vercel Blob store and connect
# it to this project. Required in production so the journal persists.
# BLOB_READ_WRITE_TOKEN=
